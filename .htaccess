Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Block dotfiles and internal project files from direct web access.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:README\.txt|THIRD-PARTY-NOTICES\.txt|\.gitignore)$ - [F,L]
RewriteRule ^(config|includes)/ - [F,L]

# Canonicalize the direct front-controller URL.
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ https://unicodefix.com/ [R=301,L]

# Enforce HTTPS and the non-www canonical hostname.
RewriteCond %{HTTP_HOST} ^(www\.)?unicodefix\.com$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.unicodefix\.com$ [NC]
RewriteRule ^ https://unicodefix.com%{REQUEST_URI} [R=301,L]

# Route clean one-segment tool and information URLs through the front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9-]+)/?$ index.php?slug=$1 [QSA,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# Assets are cached for one day without immutable, so deployments can update them promptly.
<FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2)$">
 Header set Cache-Control "public, max-age=86400"
</FilesMatch>
<FilesMatch "\.(php|html?)$">
 Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
